{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": ""
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "DefaultUILanguage": "en-GB", // Always ensure en-GB replaces en-US everywhere
        "SanitizeTinyMce": true,
        "UseHttps": true, // Always use HTTPS everywhere
        "NoNodesViewPath": "~/umbraco/UmbracoWebsite/Deploy/NoNodes.cshtml",
        "Id": "686d97d3-39f9-43cc-9e88-e1c55dae70bf"
      },
      "Hosting": {
        "Debug": false
      },
      "Content": {
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto", // Set ModelsBuilder to SourceCodeAuto mode to be compatible with Visual Studio.
        "ModelsNamespace": "Stoolball.Web.Models",
        "ModelsDirectory": "~/Models/ModelsBuilder",
        "IncludeVersionNumberInGeneratedModels": false
      },
      "RuntimeMinification": {
        "useInMemoryCache": false,
        "cacheBuster": "Version"
      },
      "RichTextEditor": {
        "ValidElements": "+a[id|rel|data-id|data-udi|rev|charset|hreflang|lang|tabindex|type|name|href|target|class],-strong/-b[class],-em/-i[class],-strike[class],p[id|style|class],-ol[style|class|reversed|start|type],-ul[style|class],-li[class],br[class],-sub[class],-sup[class],-blockquote[class],-table[class|id|lang],-tr[id|lang|class|rowspan],tbody[id|class],thead[id|class],tfoot[id|class],#td[id|lang|class|colspan|rowspan],#th[id|lang|class|colspan|rowspan|scope],caption[id|lang|class],-div[id|class],-span[class],-pre[class],-h1[id|class],-h2[id|class],-h3[id|class],-h4[id|class],-h5[id|class],-h6[id|class],hr[class],small[class],dd[id|class|lang],dl[id|class|lang],dt[id|class|dir|lang]"
      }
    }
  },
  "uSync": {
    "Sets": {
      "Default": {
        "DisabledHandlers": [
          "DataTypeHandler",
          "LanguageHandler",
          "DictionaryHandler",
          "ContentTypeHandler",
          "MacroHandler",
          "MediaTypeHandler",
          "MemberTypeHandler",
          "TemplateHandler",
          "ContentTemplateHandler",
          "DomainHandler",
          "RelationTypeHandler"
        ]
      }
    }
  }
}
