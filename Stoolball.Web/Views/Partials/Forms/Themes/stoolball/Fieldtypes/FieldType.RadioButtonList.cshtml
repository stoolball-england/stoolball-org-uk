@model Umbraco.Forms.Web.Models.FieldViewModel  
@inject Stoolball.Web.Forms.IUmbracoFormsLabeller labeller
@using Umbraco.Forms.Web
  
@{ var i = 0; }
   
<div class="@Html.GetFormFieldClass(Model.FieldTypeName) radiobuttonlist" id="@labeller.ElementId(Model.Id)">
@foreach (Umbraco.Forms.Web.Models.PrevalueViewModel pv in Model.PreValues)  
{
    <div class="custom-control custom-radio">
        <input type="radio" name="@Model.Id" id="@string.Concat(labeller.ElementId(Model.Id),"_",i)" value="@pv.Value" class="custom-control-input"
               @if (Model.Mandatory) { <text> data-val="true" data-rule-required="true" data-msg-required="@Model.RequiredErrorMessage" </text> }
               @if (Model.ContainsValue(pv.Value)) { <text> checked="checked" </text> } />
        <label for="@string.Concat(labeller.ElementId(Model.Id),"_",i)" class="custom-control-label">@pv.Value</label>
    </div>
    
    i++;
}
</div>