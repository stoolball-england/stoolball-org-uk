  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "18bc324c-3b1f-41fb-941b-04ae69d2af05",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003E\u003Ca href=\u0022/{localLink:2d6cea98-6351-4f49-b2d9-fc563a62f2e1}\u0022 type=\u0022document\u0022 title=\u0022Matches and results - why you should add yours\u0022\u003EMatches and results - why you should add yours\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EIt\u0027s easy to add your matches and results to our website, and there are lots of reasons why it\u0027s a good idea.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:a2c5e9eb-47e5-4d77-a1ed-ce30c57b21ad}\u0022 type=\u0022document\u0022 title=\u0022How to add match results\u0022\u003EHow to add match results\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EAdd your match results to this website to see your updated league table and detailed statistics for your team, your league, and all of your players.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:5b5ad710-f57c-475c-b63c-fc661ce9ead1}\u0022 type=\u0022document\u0022 title=\u0022Manage player names and statistics\u0022\u003EManage player names and statistics\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003ETidy up the list of players on your team to improve the accuracy of your team statistics.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:771aa143-b974-488e-adeb-3b2c011dc053}\u0022 type=\u0022document\u0022 title=\u0022League tables - how they work\u0022\u003EResults tables - how they work\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EWe can work out your league or results table for you automatically. It\u0027ll save time for your results officer, and encourage more interest in your league as players watch the season develop.\u003Ca href=\u0022/{localLink:93d2fbb6-af57-4a71-8331-015a0d29b26a}\u0022 type=\u0022document\u0022 title=\u0022Tweet your matches automatically\u0022\u003E\u003C/a\u003E\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [],
  "expose": [
    {
      "contentKey": "18bc324c-3b1f-41fb-941b-04ae69d2af05",
