<Content Key="37cdb4af-83de-4e51-8c2a-15efaadf570f" Alias="Start a new stoolball team" Level="3">
  <Info>
    <Parent Key="95c7b773-f70b-4e60-bc37-0f5bd5e007a9">Organise</Parent>
    <Path>/Home/Organise/StartANewStoolballTeam</Path>
