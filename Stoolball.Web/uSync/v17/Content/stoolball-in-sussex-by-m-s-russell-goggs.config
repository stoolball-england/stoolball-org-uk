    {
      "contentTypeKey": "b87922c7-a6a3-460b-affb-306139789583",
      "key": "5d2f3ce0-2fe5-4eb5-b4d8-509cc1de0599",
      "values": [
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
