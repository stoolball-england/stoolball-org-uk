  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "306ef3d4-52ae-4a5b-aef9-43d990ebc9bd",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EGetty Images have \u003Ca href=\u0022http://www.gettyimages.no/galleries/search?phrase=stool-ball\u0026amp;family=Editorial\u0026amp;sort=mostpopular\u0022\u003Ethese photos in the Getty archive\u003C/a\u003E from the heyday of stoolball in the 1930s, when there were four times as many clubs in right across England as there are today.\u003C/p\u003E\n\u003Cp\u003EThe man largely responsible for this success was \u003Ca href=\u0022/{localLink:44bad0a9-ff65-40b2-be2b-91b3406895ea}\u0022 type=\u0022document\u0022 title=\u0022Major W W Grantham\u0022\u003EMajor W W Grantham\u003C/a\u003E, founder of the forerunner to Stoolball England, the Stoolball Association for Great Britain. Grantham\u2019s other passion was the traditional Sussex smock which he\u2019s wearing the first photo.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "420bf4c7-ff49-49ae-9e07-a62f6d9c5879",
      "key": "348b1d0d-7441-4744-a5a5-68b4b5881f90",
      "values": [
        {
          "alias": "gettyImageURL",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://embed.gettyimages.com/embed/3374340?et=03Zq1azoR6NAX9onWRe7IQ\u0026viewMoreLink=off\u0026sig=xsVDJ3f6XAr93pzcfeofao4xA67aVRXaliOyPOX9bTU=\u0026caption=false"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "21st September 1938: Stoolball captain for a Kent team Miss B Field with her pet dog. She is chatting to umpire W W Grantham KC and Mrs A Kemp, captain of Sussex."
        }
      ]
    },
    {
      "contentTypeKey": "420bf4c7-ff49-49ae-9e07-a62f6d9c5879",
      "key": "3bc1da3d-1bfd-451c-bb28-d6eeecadf0d1",
      "values": [
        {
          "alias": "gettyImageURL",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://embed.gettyimages.com/embed/3347346?et=ONDc0lK-RldAkGDno9_KXg\u0026viewMoreLink=off\u0026sig=Am5vdx461Zzi8j-NS2po7kF6qiycY7bdZMon27tlS7U=\u0026caption=false"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "21st September 1938: Members of Kent and Sussex teams admiring stoolball bats which have been collected from allover the world by umpire, W W Grantham KC. (Photo by A. Hudson/Topical Press Agency/Getty Images)"
        }
      ]
    },
    {
      "contentTypeKey": "420bf4c7-ff49-49ae-9e07-a62f6d9c5879",
      "key": "6dafe03c-b87d-4966-9d3e-e5c3d38cea86",
      "values": [
        {
          "alias": "gettyImageURL",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://embed.gettyimages.com/embed/3249462?et=1sROaG7DS0t-GDc1azGWsQ\u0026viewMoreLink=off\u0026sig=JcsZZ-7pV2rKYLKxFXQ59R4RWqp54Ds1DR0rn85RxNo=\u0026caption=false"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "21st August 1935: Girls playing stool-ball in the playground at Star Road School in Fulham, London."
        }
      ]
    },
    {
      "contentTypeKey": "420bf4c7-ff49-49ae-9e07-a62f6d9c5879",
      "key": "a53b5e2b-cb0e-4d4b-a562-2f2a471b430d",
      "values": [
        {
          "alias": "gettyImageURL",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://embed.gettyimages.com/embed/3376547?et=UyyaALHQRNlBm70D62Zzvw\u0026viewMoreLink=off\u0026sig=3o266xaleEyle5eI9IvP64GhFlLOaxTSuOh7dBuSerY=\u0026caption=false"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "31st May 1930: Miss Field Marsham and Mrs Mitchell opening batsmen for the Red Armlet team, going out to bat."
        }
      ]
    },
    {
      "contentTypeKey": "420bf4c7-ff49-49ae-9e07-a62f6d9c5879",
      "key": "59a69735-3254-407a-807d-9dc64fe3c625",
      "values": [
        {
          "alias": "gettyImageURL",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://embed.gettyimages.com/embed/3428962?et=D22ALjcUTk91skB2B_aqdg\u0026viewMoreLink=off\u0026sig=rM9ZeokGFD9N6F-PRAMFM1-EtGJrfqo3IW3R_ch6-Ew=\u0026caption=false"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "16th May 1930: A group of spectators appear less than enthused by the spectacle of the Duke of Norfolk playing stoolball at Arundel Castle, West Sussex. "
        }
      ]
    },
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "78b158b5-4339-4495-a688-8e442c01c5c9",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EThere is also an \u003Ca href=\u0022https://www.gettyimages.co.uk/detail/news-photo/farmers-at-work-stoolball-an-ancient-bell-tower-how-the-news-photo/932205438\u0022\u003Eillustration of stoolball from \u0027The Graphic\u0027 in 1884\u003C/a\u003E in the Getty archive, which we are not able to include on this page.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
