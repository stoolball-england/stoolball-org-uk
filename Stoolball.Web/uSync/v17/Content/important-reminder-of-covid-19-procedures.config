  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "98d31ed4-06ac-413a-aded-a731ff2f5802",
      "values": [
        {
          "alias": "text",
