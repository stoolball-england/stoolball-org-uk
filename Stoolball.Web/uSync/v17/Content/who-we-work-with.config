  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "2dd924c8-77db-423b-8628-0e423fd4af86",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EAt Stoolball England we work with a wide range of other organisations to develop the sport of stoolball. Here are just a few of our partners. If you\u0027d like to help us support and develop stoolball, please \u003Ca href=\u0022/{localLink:243a0616-2f21-4eb6-b26c-9d77631cd731}\u0022 type=\u0022document\u0022 title=\u0022Contact us about stoolball\u0022\u003Econtact us\u003C/a\u003E.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022http://www.sportengland.org\u0022\u003ESport England\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003ESport England is a government agency working to promote sport and increase participation across the country. Sport England recognises stoolball as a sport, and Stoolball England as its governing body.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022http://www.thisgirlcan.co.uk/\u0022\u003EThis Girl Can\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EThis Girl Can is a national campaign designed to encourage more women and girls to get active. The campaign is funded by Sport England and the National Lottery.\u003C/p\u003E\n\u003Cp\u003E\u003Cimg src=\u0022\u0022 alt=\u0022Funded by the National Lottery and Sport England\u0022 width=\u0022428\u0022 height=\u0022100\u0022 data-udi=\u0022umb://media/3723fbad773747579c2e75c1db399b37\u0022 /\u003E\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022http://www.activesussex.org\u0022\u003EActive Sussex\u003C/a\u003E and \u003Ca href=\u0022http://www.activesurrey.com\u0022\u003EActive Surrey\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EThe local County Sports Partnerships share Sport England\u0027s aim to promote and increase participation, and work to make that happen in their local area. We work with them to make sure stoolball can help to achieve that goal.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022http://www.horshamleisurelink.co.uk\u0022\u003EHorsham Leisure Link\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EStoolball England is working with Horsham Leisure Link and teams in the Horsham area to secure funding for some exciting plans to develop stoolball, both locally and for the sport as a whole.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022http://www.sportandrecreation.org.uk\u0022\u003ESport and Recreation Alliance\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EThe Sport and Recreation Alliance represents national governing bodies of sports in the UK. We work with them to keep up-to-date on the national and legal issues affecting stoolball at all levels.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022http://www.sportsleaders.org\u0022\u003ESports Leaders UK\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EGet training and earn a qualification with Sports Leaders UK. You could help your local community, including the stoolball club, and it could even lead to a whole new career. Sports Leaders UK trains over 200,000 people each year.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [],
  "expose": [
    {
      "contentKey": "2dd924c8-77db-423b-8628-0e423fd4af86",
