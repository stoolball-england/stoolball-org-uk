  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "1e842305-259d-4448-b804-168859f39623",
      "key": "49c39470-ccfc-4cdb-b4d5-c5c031799a54",
      "values": [
        {
          "alias": "text",
