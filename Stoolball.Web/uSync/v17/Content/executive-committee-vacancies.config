  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "d5ebfc33-901a-4c15-8356-67e0c2f37b85",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EStoolball England is an exciting and forward-thinking National Governing Body and we are looking for two new committee members to join the team.\u003C/p\u003E\n\u003Cp\u003EWe have two vacant roles, both available on a voluntary basis. We would be pleased to hear from you if you are interested in either post. \u00A0Please \u003Ca href=\u0022/{localLink:243a0616-2f21-4eb6-b26c-9d77631cd731}\u0022 type=\u0022document\u0022 title=\u0022Contact us about stoolball\u0022\u003Econtact us\u003C/a\u003E \u003Ca href=\u0022https://www.stoolball.org.uk/contact/email?to=WHc5bjhrY1NmMm9DOGEzLzFwNWo3ZWtHZUFMTQ%3D%3D\u0026amp;tag=EMzI%2B1vlslpkos2VIaFl6A%3D%3D\u0022\u003E\u003C/a\u003E to register your interest and tell us why you would like to join the Executive Committee.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "7b90d74a-3aff-4192-82ed-39994053ee37",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EHonorary Secretary\u003C/h2\u003E\n\u003Cp\u003EGeneral secretarial duties including organising regular committee meetings; taking minutes and circulating them; monitoring the Stoolball England email account; answering emails or forwarding to relevant committee member to respond; emailing information to Counties/Leagues and collecting responses; coordination of events.\u003C/p\u003E\n\u003Cp\u003EStart Date: December 2020\u003C/p\u003E\n\u003Ch2\u003EPress and Publicity Officer\u003C/h2\u003E\n\u003Cp\u003EAdvertising events Stoolball England are attending/organising, including the showcase England matches. Writing press releases and organising photography of events. This vacancy could be of interest to a Media student.\u003C/p\u003E\n\u003Cp\u003EStart Date: Immediately\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [
