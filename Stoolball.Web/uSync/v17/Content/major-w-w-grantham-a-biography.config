    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "1e842305-259d-4448-b804-168859f39623",
      "key": "9b0ff3e8-989b-4feb-bb56-a6d42b769330",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
