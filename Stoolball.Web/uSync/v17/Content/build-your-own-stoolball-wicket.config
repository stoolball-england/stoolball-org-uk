              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EIf you\u0027d prefer to build your own stoolball wicket rather than buying a ready-made set, follow this simple guide.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1e842305-259d-4448-b804-168859f39623",
      "key": "ff809692-efbd-4247-8c58-b42180973231",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ETo build one wicket similar to the one shown, you will need to cut out the following pieces:\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003E\u003Cstrong\u003EA\u003C/strong\u003E - 12\u0022 x 12\u0022 x \u00BD\u0022 (solid wood or \u00BD\u0022 plywood)\u003C/li\u003E\n\u003Cli\u003E\u003Cstrong\u003EB\u003C/strong\u003E - 53\u0022 x 2\u0022 x 2\u0022\u003C/li\u003E\n\u003Cli\u003E\u003Cstrong\u003EC\u003C/strong\u003E - 24\u0022 x 2\u0022 x 2\u0022\u003C/li\u003E\n\u003Cli\u003E\u003Cstrong\u003ED\u003C/strong\u003E - 18\u0022 x 2\u0022 x 2\u0022\u003C/li\u003E\n\u003C/ul\u003E"
          }
        },
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "e96869cb-9e41-49f1-a002-2aa8a1aa415f",
              "mediaKey": "48679926-28f3-498a-a0b3-9b80f28a9420",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "alias": "imagePosition",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Left"
        },
        {
          "alias": "showCaption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    },
    {
      "contentTypeKey": "1e842305-259d-4448-b804-168859f39623",
      "key": "8beaa420-9c8c-45b9-9d02-60adb1802efe",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
