          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFor the final step connect \u003Cstrong\u003ED \u003C/strong\u003Eto \u003Cstrong\u003EB\u003C/strong\u003E and \u003Cstrong\u003EC\u003C/strong\u003E. There are two ways to do this.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EMethod 1:\u003C/strong\u003E Use shelf brackets at least 8\u0022 long, secured with at least 1\u00BC\u0022 screws.\u003C/p\u003E"
          }
        },
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
