          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EConnect \u003Cstrong\u003EC \u003C/strong\u003Eto the bottom of \u003Cstrong\u003EB\u003C/strong\u003E using a 6\u0022 screw or something similar.\u003C/p\u003E"
          }
        },
        {
          "alias": "image",
