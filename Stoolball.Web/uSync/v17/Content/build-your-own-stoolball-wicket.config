        },
        {
          "alias": "imagePosition",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Left"
        },
        {
          "alias": "showCaption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    },
    {
      "contentTypeKey": "1e842305-259d-4448-b804-168859f39623",
      "key": "50fda7c5-a50f-476d-b308-55a7cd89eb57",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
