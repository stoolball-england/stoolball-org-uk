          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EConnect \u003Cstrong\u003EA\u003C/strong\u003E to the top of \u003Cstrong\u003EB\u003C/strong\u003E with two \u00BD\u0022 screws.\u003C/p\u003E"
          }
        },
