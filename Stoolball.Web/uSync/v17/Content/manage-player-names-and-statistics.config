<Content Key="5b5ad710-f57c-475c-b63c-fc661ce9ead1" Alias="Manage player names and statistics" Level="4">
  <Info>
    <Parent Key="435cb0f5-ac07-4cf3-8dec-f91001016f9a">Add matches and results to our website</Parent>
