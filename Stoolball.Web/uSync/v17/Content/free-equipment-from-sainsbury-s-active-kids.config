          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESainsbury\u2019s Active Kids is a scheme where supermarket shoppers collect vouchers which schools can use to buy sports equipment. Starting in 2010, this includes stoolball bats, balls and wickets. If you shop at Sainsbury\u2019s, collect the vouchers and ask your local school to invest them in stoolball.\u003C/p\u003E\n\u003Cp\u003ESchools near a branch of Sainsbury\u2019s typically receive tens of thousands of vouchers in a season, more than enough to buy all the equipment they need to play stoolball.\u003C/p\u003E\n\u003Cp\u003E\u003Ca href=\u0022https://activekids.sainsburys.co.uk/\u0022\u003ESainsbury\u2019s Active Kids\u003C/a\u003E\u003C/p\u003E"
          }
        }
      ]
    }
  ],
