<Content Key="d252d70c-eb31-4bf2-ba92-d4b7deed01b2" Alias="Indoor stoolball" Level="3">
  <Info>
    <Parent Key="b44a85a4-5b3b-453e-b859-54e3996b0c60">Rules</Parent>
