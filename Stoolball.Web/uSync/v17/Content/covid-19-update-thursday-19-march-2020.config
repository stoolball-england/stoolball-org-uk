  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "8ebf0436-5b76-4f38-b2a3-e4f87eac5869",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E\u003Cstrong\u003EAll\u003C/strong\u003E forms of stoolball and associated activities are suspended as of 19 March 2020.\u003C/p\u003E\n\u003Cp\u003EFollowing the Government\u2019s latest advice around social distancing, we would recommend that all forms of stoolball are suspended until further notice. This suspension extends to pre season training, friendlies and any associated Stoolball Activity.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "9042967b-c816-4763-8372-9bcb19d67011",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EStoolball England will continue to monitor the situation, liaise with relevant sporting bodies including Sport England and The Sport and Recreation Alliance and hope that we will all be able to start playing in the near future.\u003C/p\u003E\n\u003Cp\u003EMay we remind you that you can access relevant information through the \u003Ca href=\u0022https://www.gov.uk/coronavirus\u0022\u003Egovernment website\u003C/a\u003E, and you can access health information on the UK Government\u0027s \u003Ca href=\u0022https://publichealthmatters.blog.gov.uk/2020/01/23/wuhan-novel-coronavirus-what-you-need-to-know/\u0022\u003EPublic Health Matters blog\u003C/a\u003E.\u003C/p\u003E\n\u003Cp\u003EWhen we have further guidance we will notify you. Until then \u003Cstrong\u003Eall\u003C/strong\u003E forms of stoolball and associated activities are suspended.\u003C/p\u003E\n\u003Cp\u003EIn the mean time we will try and create and promote fun ways to practice our beloved sport in self-isolation. Feel free to send us some innovative ways of doing this!\u003C/p\u003E\n\u003Cp\u003EStay safe everyone, hopefully we will be back soon!\u003C/p\u003E\n\u003Cp\u003EFrom the Stoolball England Committee.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [
    {
      "contentTypeKey": "3b2b6ed4-da92-4aca-9262-fbfec272be72",
