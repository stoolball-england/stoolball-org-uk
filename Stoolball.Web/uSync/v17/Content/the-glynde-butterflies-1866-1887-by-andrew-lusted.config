  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "1e842305-259d-4448-b804-168859f39623",
      "key": "524e7f5a-49ef-47ba-9914-8bfeb9f0001a",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
