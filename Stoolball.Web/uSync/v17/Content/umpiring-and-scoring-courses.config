  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "d2b9eac7-65c1-4a12-ba69-2af36fd828e7",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOur courses for stoolball umpires and scorers are typically held together. The two groups learn their subjects in separate indoor sessions, then come together outside (weather permitting) to umpire and score a practice match.\u003C/p\u003E\n\u003Cp\u003EThe umpiring course cover the practical side of umpiring, such as where to stand and how to signal, and guidance on matters that require the umpire\u0027s opinion. Scorers will learn to handle unusual scenarios correctly as well as the more common ones. The aim is not to teach the rules of stoolball, so attendees should have at least a basic understanding of the rules before they come.\u003C/p\u003E\n\u003Cp\u003EThese courses take place once or twice per year according to demand and the availability of tutors. The ideal number for umpiring courses is 10-12 people, and 4-6 people for the scoring course.\u003C/p\u003E\n\u003Cp\u003EIf you would like to attend any of these courses, please \u003Ca href=\u0022/{localLink:243a0616-2f21-4eb6-b26c-9d77631cd731}\u0022 type=\u0022document\u0022 title=\u0022Contact us about stoolball\u0022\u003Econtact us\u003C/a\u003E.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [],
  "expose": [
