    {
      "contentTypeKey": "b87922c7-a6a3-460b-affb-306139789583",
      "key": "4b06d8ef-0c67-4b8a-9510-d22006591799",
      "values": [
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "0ccbeedd-f187-48b7-8ba2-dc31bd805354",
              "mediaKey": "198974d8-f7d6-4b5a-977b-a15bcef525e8",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
