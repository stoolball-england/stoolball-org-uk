<?xml version="1.0" encoding="utf-8"?>
<Content Key="43db7b32-0d2c-4f46-ba2c-2c07b87604c0" Alias="Stoolball England COVID-19 statement - Thursday 9 July 2020" Level="3">
  <Info>
    <Parent Key="620f2f17-c7d2-43b0-8abb-d67248835c1b">News</Parent>
    <Path>/Home/News/StoolballEnglandCOVID19StatementThursday9July2020</Path>
    <Trashed>false</Trashed>
