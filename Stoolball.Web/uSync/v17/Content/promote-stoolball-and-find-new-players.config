<Content Key="6de19ba3-220d-4096-95f7-1249f8638000" Alias="Promote stoolball and find new players" Level="3">
  <Info>
    <Parent Key="95c7b773-f70b-4e60-bc37-0f5bd5e007a9">Organise</Parent>
