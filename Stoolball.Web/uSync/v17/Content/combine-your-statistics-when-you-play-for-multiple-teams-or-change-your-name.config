<Content Key="2f3fe275-c158-4e12-824d-4a32beacb0c7" Alias="Combine your statistics when you play for multiple teams or change your name" Level="3">
  <Info>
    <Parent Key="620f2f17-c7d2-43b0-8abb-d67248835c1b">News</Parent>
    <Path>/Home/News/CombineYourStatisticsWhenYouPlayForMultipleTeamsOrChangeYourName</Path>
