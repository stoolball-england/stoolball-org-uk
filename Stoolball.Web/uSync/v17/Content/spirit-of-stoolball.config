<Content Key="537d3266-7602-47c1-945c-fcbb4fb00489" Alias="Spirit of stoolball" Level="3">
  <Info>
    <Parent Key="b44a85a4-5b3b-453e-b859-54e3996b0c60">Rules</Parent>
