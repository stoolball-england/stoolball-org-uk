  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "c5007926-8bc6-4213-86f2-5c02b27d243f",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ETo all of our stakeholders.\u003C/p\u003E\n\u003Cp\u003EWe would like to advise that in view of recent government announcements regarding indoor team sport for adults, Indoor Stoolball leagues will not be permitted until further notice.\u003C/p\u003E\n\u003Cp\u003EYou can \u003Ca href=\u0022https://www.sportengland.org/news/rule-six-be-applied-adult-indoor-team-sports\u0022\u003Eread the full guidance from Sport England\u003C/a\u003E. We will hopefully be back to playing stoolball indoors soon.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "b87922c7-a6a3-460b-affb-306139789583",
