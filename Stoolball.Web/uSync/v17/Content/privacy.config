            },
            "markup": "\u003Ch2\u003E\u003Ca href=\u0022/{localLink:dc123cda-1cac-4aea-9c25-44032e516751}\u0022 type=\u0022document\u0022 title=\u0022Cookies\u0022\u003ECookies\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003ECookies are a normal part of every website. How much we do with them is your choice.\u003Ca href=\u0022/{localLink:e0b74832-f0c8-41b0-8f00-0965f8e4793d}\u0022 type=\u0022document\u0022 title=\u0022Privacy notice \u2013 match results and comments\u0022\u003E\u003C/a\u003E\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:d614444e-ea0a-4f36-b107-336c1f6aed88}\u0022 type=\u0022document\u0022 title=\u0022Privacy notice - registering with Stoolball England\u0022\u003EPrivacy notice - your Stoolball England account\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EWhat happens to your information when you create an account on this website, and your rights.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:5f291c99-6c97-4859-a801-437bf9865960}\u0022 type=\u0022document\u0022 title=\u0022Privacy notice - public and private contact details\u0022\u003EPrivacy notice - public and private contact details\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EWhat happens to information you provide when we ask for contact details for competitions, teams, tournaments and school stoolball.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:e0b74832-f0c8-41b0-8f00-0965f8e4793d}\u0022 type=\u0022document\u0022 title=\u0022Privacy notice \u2013 match results and comments\u0022\u003EPrivacy notice \u2013 match results and comments\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EHow we use information submitted about matches, and your rights.\u003C/p\u003E"
          }
        }
