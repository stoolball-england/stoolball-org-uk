<Content Key="4d1c0be4-d40c-4aff-8e04-d5d9e44a13bb" Alias="Insurance – a MUST for every club" Level="3">
  <Info>
    <Parent Key="95c7b773-f70b-4e60-bc37-0f5bd5e007a9">Organise</Parent>
