<Content Key="f8e162da-9fe3-46f6-af86-d748bd9f9269" Alias="Stoolball England “Train the Trainers”" Level="3">
  <Info>
    <Parent Key="620f2f17-c7d2-43b0-8abb-d67248835c1b">News</Parent>
