          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cdiv class=\u0022nav\u0022\u003E\n\u003Ch2\u003E\u003Ca href=\u0022https://shop.spreadshirt.co.uk/stoolball\u0022\u003EGift shop\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EBuy hoodies, t-shirts, hats, bags, umbrellas, teddy bears and a lot more in our stoolball gift shop. Like us on Facebook or follow us on Twitter to find out about special offers.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:2813c29b-aef9-41db-ae53-215dc2178fcb}\u0022 type=\u0022document\u0022 title=\u0022Buy stoolball equipment from Stoolball England\u0022\u003EBuy stoolball equipment from Stoolball England\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EYou can buy approved stoolball bats, balls, wickets, scorebooks and training materials from Stoolball England.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:5e8e8761-9368-45b6-b849-07ad5269e900}\u0022 type=\u0022document\u0022 title=\u0022Looking after bats, balls, wickets and other equipment\u0022\u003ELooking after bats, balls, wickets and other equipment\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003ECheck that you have everything you need to play stoolball, and find out how to extend the life of your stoolball equipment with a few simple steps.\u003C/p\u003E\n\u003Ch2\u003E\u003Ca href=\u0022/{localLink:b85ad759-ff9b-4206-ab19-f43b384ffc66}\u0022 type=\u0022document\u0022 title=\u0022Build your own stoolball wicket\u0022\u003EBuild your own stoolball wicket\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EIf you\u0027d prefer to build your own stoolball wicket rather than buying a ready-made set, follow this simple guide.\u003C/p\u003E\n\u003C/div\u003E"
          }
        }
      ]
    }
  ],
