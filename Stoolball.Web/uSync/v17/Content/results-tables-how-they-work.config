<?xml version="1.0" encoding="utf-8"?>
<Content Key="771aa143-b974-488e-adeb-3b2c011dc053" Alias="Results tables - how they work" Level="4">
  <Info>
    <Parent Key="435cb0f5-ac07-4cf3-8dec-f91001016f9a">Add matches and results to our website</Parent>
    <Path>/Home/Organise/AddMatchesAndResultsToOurWebsite/ResultsTablesHowTheyWork</Path>
    <Trashed>false</Trashed>
