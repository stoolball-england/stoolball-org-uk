  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "f7457915-b6bc-4ad0-9e29-c8b0cd7ef1a8",
