  <Properties>
    <blockList>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "41914047-aec3-497f-a8bd-fd6b8fabb894",
      "key": "45e2df0e-5dd0-4e22-bc19-03bd479e728c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EI hereby give notice of the 43rd Annual General Meeting of Stoolball England to be held\u003Cbr /\u003Eon zoom on Wednesday 23 rd November 2022, starting at 7pm. Please notify all your\u003Cbr /\u003ELeague or Association members of this date. Any League, Association or Club in membership\u003Cbr /\u003Emay attend this meeting, but only Stoolball England officers, Vice-Presidents and one\u003Cbr /\u003Erepresentative from each affiliated body are entitled to vote.\u003C/p\u003E\n\u003Cp\u003EThe Agenda and zoom code will be forwarded to you.\u003C/p\u003E\n\u003Cp\u003EWe are seeking volunteers for the following committee positions becoming vacant; Social-\u003Cbr /\u003EMedia Secretary and General Committee members. Please pass this information on to\u003Cbr /\u003Eyour Associations, County\u2019s, Divisions or Leagues and ask members to email the Stoolball\u003Cbr /\u003EEngland account with their name, contact email and phone number. Please ensure that\u003Cbr /\u003Epersons nominated are agreeable to being put forward for the position they are willing\u003Cbr /\u003Eto stand for. In addition to the proposal of any nomination the candidate would need to\u003Cbr /\u003Ehave a seconder.\u003C/p\u003E\n\u003Cp\u003EWe ask that Stoolball England are informed of attendance prior to the meeting due to ensure\u003Cbr /\u003Ethat anyone who wishes to be present is accepted into the meeting.\u003C/p\u003E\n\u003Cp\u003EPlease make every effort to come to the AGM. It is important for the wellbeing of the\u003Cbr /\u003Egame that those of you who are involved in the organisation and structure of stoolball\u003Cbr /\u003Eattend this meeting to express your views. I look forward to seeing you there.\u003C/p\u003E\n\u003Cp\u003EKind regards\u003C/p\u003E\n\u003Cp\u003EGwynn Griffith\u003Cbr /\u003EChairman, Stoolball England\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [
