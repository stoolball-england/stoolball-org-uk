{
  "name": "stoolball",
  "version": "1.0.0",
  "description": "This is a rebuild of the Stoolball England website at www.stoolball.org.uk using .NET Framework and Umbraco Cloud.",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "test:e2e": "playwright test -c Playwright",
    "test:e2e:ui": "playwright test -c Playwright --ui"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^4.6.1",
    "popper.js": "^1.16.1-lts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "html-validate": "^9.7.1",
    "jest": "^28.1.1",
    "jest-environment-jsdom": "^28.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "projects": [
      "<rootDir>/Stoolball.Web/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/Playwright/"
    ],
    "coverageReporters": [
      "text",
      "cobertura"
    ]
  },
  "prettier": {
    "editor.formatOnSave": true
  }
}
